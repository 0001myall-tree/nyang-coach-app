<?xml version="1.0" encoding="utf-8"?>
<!-- 틈새 코칭 카드. 버튼은 데려가는 것 하나뿐이다.
     무엇을 할지 정해주지 않는 자리라 거절 버튼이 없다 — 바깥을 누르거나 그냥
     두면 사라지고, 어느 쪽이든 다시 부르지 않는다. 대신 하고 싶어진 사람이
     할 일 창까지 가는 길은 한 번에 닿아야 해서 버튼으로 낸다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nudge_gap_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="false">

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nudge_card_bg"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/nudge_gap_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="지금 잠깐 여유 있냥?"
                android:textColor="#3D3A4E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nudge_gap_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="이따 할 일, 10분만 먼저 해두면 훨씬 가벼워질 거라냥."
                android:textColor="#6B6676"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/nudge_gap_go"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/nudge_button_primary"
                android:gravity="center"
                android:text="이따 할 일 바로 보기"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

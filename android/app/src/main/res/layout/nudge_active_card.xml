<?xml version="1.0" encoding="utf-8"?>
<!-- 적극 코칭이 일 하나를 부를 때 펼쳐지는 카드.

     답은 넷이다. 하겠다는 답 하나와, 못 하는 이유 셋. 이유를 카드에서 바로
     받으면 앱에 들어가 "왜 못 했어?"를 한 번 더 묻지 않아도 된다.

     하겠다는 쪽만 크게 둔다. 넷을 같은 크기로 세우면 셋이 빠져나가는 문이라
     눈이 그쪽으로 먼저 간다. 이유들은 그 아래 작게 한 줄로 둔다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nudge_active_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="false">

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nudge_card_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/nudge_active_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:textColor="#3D3A4E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/nudge_active_image"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="냥냥코치"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/nudge_active_go"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/nudge_button_primary"
            android:gravity="center"
            android:text="지금 할게"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nudge_active_no_time"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/nudge_button_secondary"
                android:gravity="center"
                android:maxLines="1"
                android:text="시간이 안 나"
                android:textColor="#6B6676"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nudge_active_not_here"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/nudge_button_secondary"
                android:gravity="center"
                android:maxLines="1"
                android:text="여기선 못 해"
                android:textColor="#6B6676"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nudge_active_reluctant"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/nudge_button_secondary"
                android:gravity="center"
                android:maxLines="1"
                android:text="하기 싫어"
                android:textColor="#6B6676"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>

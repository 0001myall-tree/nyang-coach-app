<?xml version="1.0" encoding="utf-8"?>
<!-- 냥냥이를 눌렀을 때만 펼쳐지는 카드. 이때는 사용자가 스스로 부른 것이라
     화면 전체를 덮어도 되고, 바깥을 누르면 다시 작아진다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nudge_card_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="false">

    <!-- 가로로 눕히면 카드가 화면보다 길어질 수 있다. 잘리는 대신 스크롤되게 둔다. -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nudge_card_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/nudge_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:textColor="#3D3A4E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/nudge_card_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="냥냥코치"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/nudge_card_done"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/nudge_button_primary"
            android:gravity="center"
            android:text="다 했어"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nudge_card_continue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nudge_button_secondary"
            android:gravity="center"
            android:text="계속하는 중"
            android:textColor="#3D3A4E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nudge_card_paused"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nudge_button_secondary"
            android:gravity="center"
            android:text="잠깐 멈췄어"
            android:textColor="#6B6676"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
